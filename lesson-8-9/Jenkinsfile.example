pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:latest
    command:
    - /busybox/sh
    - -c
    - sleep 3600
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker
    - name: aws-credentials
      mountPath: /root/.aws
      readOnly: true
  volumes:
  - name: docker-config
    emptyDir: {}
  # AWS credentials через secret (если не используется IRSA)
  # - name: aws-credentials
  #   secret:
  #     secretName: aws-ecr-credentials
"""
        }
    }
    
    environment {
        // Обновите ECR_REPO на ваш URL из terraform output
        ECR_REPO = '053414411835.dkr.ecr.us-west-2.amazonaws.com/lesson-8-9-django-ecr'
        AWS_REGION = 'us-west-2'
        GIT_SHA = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
        // Credentials должны быть настроены в Jenkins
        GITOPS_REPO = credentials('gitops-repo-url')  // ID: gitops-repo-url
        GITHUB_PAT = credentials('github-pat')        // ID: github-pat
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build and Push to ECR') {
            steps {
                container('kaniko') {
                    script {
                        echo "Building Docker image with Kaniko..."
                        echo "ECR Repository: ${ECR_REPO}"
                        echo "Image Tag: ${GIT_SHA}"
                        
                        // Kaniko использует AWS credentials через IRSA (service account)
                        // или через mounted volume (если настроено)
                        // Kaniko автоматически логинится в ECR используя AWS credentials
                        sh """
                        /kaniko/executor \
                          --context . \
                          --dockerfile Dockerfile \
                          --destination ${ECR_REPO}:${GIT_SHA} \
                          --destination ${ECR_REPO}:latest \
                          --cache=true \
                          --cache-ttl=24h \
                          --snapshot-mode=redo \
                          --verbosity=info
                        """
                        
                        echo "✅ Image successfully pushed to ECR: ${ECR_REPO}:${GIT_SHA}"
                    }
                }
            }
        }
        
        stage('Update GitOps Repository') {
            steps {
                script {
                    dir('gitops') {
                        echo "Cloning GitOps repository..."
                        // Клонирование GitOps репозитория (Repo B)
                        sh """
                        git clone https://${GITHUB_PAT}@${GITOPS_REPO} .
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@ci.example.com"
                        """
                        
                        echo "Updating values.yaml with new image tag..."
                        // Обновление image.tag в values.yaml используя sed
                        // Это обновит тег образа для Argo CD
                        sh """
                        # Обновляем image.tag
                        sed -i.bak 's|tag:.*|tag: ${GIT_SHA}|g' charts/django-app/values.yaml
                        
                        # Обновляем image.repository (если нужно)
                        sed -i.bak 's|repository:.*|repository: ${ECR_REPO}|g' charts/django-app/values.yaml || true
                        
                        # Проверяем изменения
                        git diff charts/django-app/values.yaml || true
                        """
                        
                        echo "Committing and pushing changes to GitOps repository..."
                        // Коммит и push изменений в GitOps репозиторий
                        // Argo CD автоматически обнаружит изменения и синхронизирует
                        sh """
                        git add charts/django-app/values.yaml
                        git commit -m "CI: Update image tag to ${GIT_SHA}

                        - Updated image.tag to ${GIT_SHA}
                        - Image: ${ECR_REPO}:${GIT_SHA}
                        - Build triggered by Jenkins pipeline" || exit 0
                        
                        git push origin main
                        """
                        
                        echo "✅ GitOps repository updated. Argo CD will sync automatically."
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo "Pipeline успешно завершен. Образ ${ECR_REPO}:${GIT_SHA} запушен в ECR."
        }
        failure {
            echo "Pipeline завершился с ошибкой. Проверьте логи."
        }
        always {
            cleanWs()
        }
    }
}

